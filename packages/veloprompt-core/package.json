{
  "name": "veloprompt-core",
  "version": "0.1.0",
  "description": "Motor de detección y anonimización de datos sensibles de VeloPrompt. 100 % local, sin dependencias.",
  "license": "MIT",
  "author": "Zaisor Technology LLC",
  "homepage": "https://zaisor.io/veloprompt",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "bench": "tsup && node bench/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
