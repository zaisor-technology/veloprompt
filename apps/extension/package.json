{
  "name": "veloprompt-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Extensión de navegador de VeloPrompt: tapa datos sensibles antes de enviarlos a la IA.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "VP_E2E=1 wxt build --mode e2e",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "pnpm build:e2e && playwright test --project=adaptadores --project=e2e",
    "screenshots": "pnpm build:e2e && playwright test --project=capturas",
    "store:images": "pnpm build:e2e && playwright test --project=tienda"
  },
  "dependencies": {
    "veloprompt-core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
