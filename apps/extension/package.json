{
  "name": "veloprompt-extension",
  "version": "0.2.0",
  "private": true,
  "description": "Extensión de navegador de VeloPrompt: tapa datos sensibles antes de enviarlos a la IA.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "VP_E2E=1 wxt build --mode e2e",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "pnpm build:e2e && playwright test",
    "screenshots": "pnpm build:e2e && playwright test --project=capturas"
  },
  "dependencies": {
    "veloprompt-core": "workspace:*"
  }
}
